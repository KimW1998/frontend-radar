# Optional: site-wide PAT for public release-note fetches only (NOT used for user repo imports).
# Create at https://github.com/settings/tokens (public_repo read scope is enough)
GITHUB_TOKEN=

# Per-user GitHub login (OAuth App) — required for importing from each user's own repos.
# 1. Create an OAuth App at https://github.com/settings/developers
#    Homepage URL: https://your-site.netlify.app
#    Callback URL: https://your-site.netlify.app/api/github-oauth-callback
# 2. Set Client ID in both VITE_* (browser) and GITHUB_* (Netlify functions)
VITE_GITHUB_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: block imports from specific GitHub owners unless logged in as that owner
# (e.g. your personal username so others cannot import your public repos by API)
GITHUB_IMPORT_BLOCKLIST=
